# Supabase — copy to `.env` and fill in.
# Find these under: Supabase Dashboard → Project Settings → API
#
# Use the PUBLIC anon (publishable) key. NEVER put the service_role / secret key
# in a frontend app — it bypasses Row Level Security.
VITE_SUPABASE_URL=https://qsgwwhwkustsoixlglyz.supabase.co
VITE_SUPABASE_ANON_KEY=

# Gmail auto-pull (optional). Google Cloud → APIs & Services → Credentials →
# OAuth 2.0 Client ID (Web). Add your app origin to "Authorized JavaScript
# origins". Enable the Gmail API for the project.
VITE_GOOGLE_CLIENT_ID=
